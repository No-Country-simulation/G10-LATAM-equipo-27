# --- API propia ---
# Clave que deben enviar los clientes de esta API en el header X-API-Key.
API_KEY=cambia-esta-clave

# --- Discord ---
# Token del bot (Developer Portal > Bot > Reset Token). Requiere el
# "Message Content Intent" activado y permisos View Channel + Read Message History
# en el servidor donde se invito al bot.
DISCORD_BOT_TOKEN=
# ID del servidor (guild) a leer. Clic derecho sobre el servidor con el modo
# desarrollador activado > Copiar ID del servidor.
DISCORD_GUILD_ID=

# --- OCI Object Storage ---
# "instance_principal" cuando la API corre dentro de una VM de OCI (sin llaves).
# "config" para correr en local usando ~/.oci/config.
OCI_AUTH=config
OCI_CONFIG_PROFILE=DEFAULT
OCI_NAMESPACE=
OCI_BUCKET_NAME=communitylab-discord-raw
# Solo si OCI_AUTH=instance_principal y el compartment de trabajo no es el
# compartment "home" de la instancia.
OCI_COMPARTMENT_ID=
