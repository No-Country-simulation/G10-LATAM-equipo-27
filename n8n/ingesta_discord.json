    {
      "parameters": {
        "jsCode": "// relaciono el ID que entrega Discord con el nombre del canal\nconst canales = {\n  \"1550016804418621452\": \"#general\",\n  \"1551309664397033513\": \"#preguntas\",\n  \"1551309281041715230\": \"#chat-egresados\",\n  \"1551309330198953994\": \"#oportunidades-laborales\"\n};\n\n// dejo fuera los mensajes sin texto, como el aviso que Discord publica cuando el bot se une\nconst mensajes = $input.all()\n  .map(item => item.json)\n  .filter(m => m.content && m.content.trim() !== \"\");\n\n// si no quedó ningún mensaje, termino sin mandar nada al endpoint\nif (mensajes.length === 0) {\n  return [];\n}\n\n// la semana se calcula con la fecha del mensaje más reciente\nconst fechaReciente = new Date(Math.max(...mensajes.map(m => new Date(m.timestamp))));\n\nfunction semanaISO(fecha) {\n  const d = new Date(Date.UTC(fecha.getUTCFullYear(), fecha.getUTCMonth(), fecha.getUTCDate()));\n  const dia = d.getUTCDay() || 7;\n  d.setUTCDate(d.getUTCDate() + 4 - dia);\n  const inicioAnio = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));\n  return Math.ceil(((d - inicioAnio) / 86400000 + 1) / 7);\n}\n\nconst semana = String(semanaISO(fechaReciente)).padStart(2, \"0\");\n\nreturn [{\n  json: {\n    origen_comunidad: \"Discord_Grupo_ONE_G10\",\n    periodo_referencia: `Semana_${semana}`,\n    interacciones: mensajes.map(m => ({\n      autor: m.author.username,\n      canal: canales[m.channel_id] || `#${m.channel_id}`,\n      texto: m.content\n    }))\n  }\n}];"
      },
